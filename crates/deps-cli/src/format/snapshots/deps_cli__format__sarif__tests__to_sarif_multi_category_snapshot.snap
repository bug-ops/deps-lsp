---
source: crates/deps-cli/src/format/sarif.rs
expression: to_sarif(&report)
---
{
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0.json",
  "runs": [
    {
      "automationDetails": {
        "id": "[automation_id]"
      },
      "results": [
        {
          "level": "note",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Cargo.toml"
                },
                "region": {
                  "endColumn": 11,
                  "endLine": 5,
                  "startColumn": 1,
                  "startLine": 5
                }
              }
            }
          ],
          "message": {
            "text": "Newer version available: 1.1.0"
          },
          "partialFingerprints": {
            "depsCli/v1": "Cargo.toml|serde|outdated|0"
          },
          "ruleId": "outdated",
          "ruleIndex": 0
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Cargo.toml"
                },
                "region": {
                  "endColumn": 11,
                  "endLine": 5,
                  "startColumn": 1,
                  "startLine": 5
                }
              }
            }
          ],
          "message": {
            "text": "Newer version available: 1.1.0"
          },
          "partialFingerprints": {
            "depsCli/v1": "Cargo.toml|serde|vulnerable|0"
          },
          "ruleId": "vulnerable",
          "ruleIndex": 1
        }
      ],
      "tool": {
        "driver": {
          "informationUri": "https://github.com/bug-ops/deps-lsp",
          "name": "deps-cli",
          "rules": [
            {
              "id": "outdated",
              "name": "outdated",
              "shortDescription": {
                "text": "A newer version is published for the dependency's declared requirement."
              }
            },
            {
              "id": "vulnerable",
              "name": "vulnerable",
              "shortDescription": {
                "text": "A known security advisory affects the in-use version."
              }
            }
          ],
          "version": "1.0.1"
        }
      }
    }
  ],
  "version": "2.1.0"
}
